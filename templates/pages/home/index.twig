{% extends 'layouts/base.twig' %}

{% block title %}Главная - {{ config('app.name') }}{% endblock %}

{% block content %}
<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <h1 class="mb-4"><i class="fas fa-newspaper me-2"></i>Последние публикации</h1>
        
        {% if posts is empty %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>Пока нет публикаций
        </div>
        {% else %}
        <div class="row">
            {% for post in posts %}
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    {% if post.image_path %}
                    <img src="/uploads/{{ post.image_path }}" class="card-img-top" alt="{{ post.title|e }}" style="height: 200px; object-fit: cover;">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="/post/{{ post.slug }}" class="text-decoration-none">{{ post.title }}</a>
                        </h5>
                        <p class="card-text text-muted small">
                            <i class="fas fa-user me-1"></i>{{ post.author_name }} &bull;
                            <i class="fas fa-calendar me-1"></i>{{ post.published_at|date("d.m.Y") }}
                        </p>
                        <p class="card-text">{{ post.preview|striptags|slice(0, 150) }}...</p>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-eye me-1"></i>{{ post.views }}
                                <i class="fas fa-star ms-2 me-1"></i>{{ post.rating_avg|number_format(1) }}
                            </small>
                            <a href="/post/{{ post.slug }}" class="btn btn-sm btn-outline-primary">Читать далее</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <!-- Pagination -->
        {% if pagination.total > 1 %}
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                {% if pagination.has_prev %}
                <li class="page-item">
                    <a class="page-link" href="{{ pagination.prev_url }}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                {% endif %}
                
                {% for i in 1..pagination.total %}
                    {% if i == pagination.current %}
                    <li class="page-item active"><span class="page-link">{{ i }}</span></li>
                    {% elseif i == 1 or i == pagination.total or (i >= pagination.current - 2 and i <= pagination.current + 2) %}
                    <li class="page-item"><a class="page-link" href="/page/{{ i }}">{{ i }}</a></li>
                    {% elseif i == pagination.current - 3 or i == pagination.current + 3 %}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    {% endif %}
                {% endfor %}
                
                {% if pagination.has_next %}
                <li class="page-item">
                    <a class="page-link" href="{{ pagination.next_url }}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </nav>
        {% endif %}
        {% endif %}
    </div>
    
    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Best by Rating -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-trophy me-2"></i>Лучшее по рейтингу
            </div>
            <ul class="list-group list-group-flush">
                {% for post in widgets.best_by_rating %}
                <li class="list-group-item">
                    <a href="/post/{{ post.slug }}" class="text-decoration-none">{{ post.title }}</a>
                    <small class="text-muted d-block">
                        <i class="fas fa-star me-1"></i>{{ post.rating_avg|number_format(2) }}
                    </small>
                </li>
                {% else %}
                <li class="list-group-item text-muted">Нет оценок</li>
                {% endfor %}
            </ul>
        </div>
        
        <!-- Best by Views -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-success text-white">
                <i class="fas fa-fire me-2"></i>Популярное
            </div>
            <ul class="list-group list-group-flush">
                {% for post in widgets.best_by_views %}
                <li class="list-group-item">
                    <a href="/post/{{ post.slug }}" class="text-decoration-none">{{ post.title }}</a>
                    <small class="text-muted d-block">
                        <i class="fas fa-eye me-1"></i>{{ post.views }}
                    </small>
                </li>
                {% else %}
                <li class="list-group-item text-muted">Нет просмотров</li>
                {% endfor %}
            </ul>
        </div>
        
        <!-- Top Tags -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-info text-white">
                <i class="fas fa-tags me-2"></i>Теги
            </div>
            <div class="card-body">
                {% for tag in widgets.top_tags %}
                <a href="/tag/{{ tag.slug }}" class="badge bg-secondary text-decoration-none me-1 mb-1">
                    {{ tag.name }} ({{ tag.post_count }})
                </a>
                {% else %}
                <span class="text-muted">Нет тегов</span>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
