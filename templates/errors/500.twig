{% extends 'layouts/base.twig' %}

{% block title %}Ошибка сервера - 500{% endblock %}

{% block content %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-1 text-muted"><i class="fas fa-server"></i></h1>
        <h2 class="mb-4">500 - Ошибка сервера</h2>
        <p class="lead text-muted mb-4">
            Произошла непредвиденная ошибка на сервере. Пожалуйста, попробуйте позже.
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fas fa-home me-2"></i>На главную
            </a>
        </div>
    </div>
</div>
{% endblock %}
