{% extends 'layouts/base.twig' %}

{% block title %}Страница не найдена - 404{% endblock %}

{% block content %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-1 text-muted"><i class="fas fa-exclamation-triangle"></i></h1>
        <h2 class="mb-4">404 - Страница не найдена</h2>
        <p class="lead text-muted mb-4">
            К сожалению, запрашиваемая страница не существует или была перемещена.
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fas fa-home me-2"></i>На главную
            </a>
            <a href="/search" class="btn btn-outline-secondary btn-lg">
                <i class="fas fa-search me-2"></i>Поиск
            </a>
        </div>
    </div>
</div>
{% endblock %}
