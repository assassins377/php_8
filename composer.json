{
    "name": "secure-blog/blog",
    "description": "Многопользовательский блог на PHP с системой рейтингов и модерации",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.3",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.5",
        "league/oauth2-client": "^2.7",
        "intervention/image": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.17",
        "pragmarx/google2fa": "^8.0",
        "bacon/bacon-qr-code": "^3.0",
        "respect/validation": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs -p --standard=PSR12 src public/index.php",
        "cs-fix": "phpcbf -p --standard=PSR12 src public/index.php"
    }
}
